# Notifications — Catppuccin Macchiato palette
sort=-time
layer=overlay
anchor=top-right
margin=12
background-color=#24273a
text-color=#cad3f5
border-color=#c6a0f6
progress-color=over #363a4f
width=340
height=120
padding=12
border-size=2
border-radius=10
icons=1
icon-path=/usr/share/icons/Papirus-Dark
max-icon-size=48
default-timeout=5000
ignore-timeout=1
font=JetBrainsMono Nerd Font 10

[urgency=low]
border-color=#6e738d

[urgency=normal]
border-color=#c6a0f6

[urgency=high]
border-color=#ed8796
text-color=#ed8796
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category

# Do Not Disturb: makoctl mode -t do-not-disturb
[mode=do-not-disturb]
invisible=1
